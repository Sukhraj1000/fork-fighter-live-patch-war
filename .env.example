# Create a key at https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=your_daytona_api_key

# Optional Daytona defaults
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=eu

# The playable app uses deterministic local game masters by default.
GAME_MASTER_PROVIDER=mock

# Optional: select the persistent worker path after preparing the snapshot.
# GAME_MASTER_PROVIDER=daytona

# Prepared once with: pnpm --filter @fork-fighter/gm-orchestrator prepare:snapshot
DAYTONA_WORKER_SNAPSHOT=fork-fighter-game-master-codex-v4

# API-key mode (recommended for unattended automation): name of a Daytona
# organization secret mounted as CODEX_API_KEY. Never put the key value here.
DAYTONA_CODEX_SECRET_NAME=fork-fighter-codex-api-key

# ChatGPT subscription mode for trusted private workers. This copies the
# file-backed Codex auth cache into each private, TTL-bound sandbox. Treat that
# file like a password and never commit it.
# DAYTONA_CODEX_AUTH_MODE=chatgpt
# DAYTONA_CODEX_AUTH_FILE=/absolute/path/to/.codex/auth.json

# Optional persistent-worker tuning.
# DAYTONA_WORKER_TTL_MINUTES=30
# DAYTONA_WORKER_STARTUP_TIMEOUT_MS=20000

# Optional match tuning. Defaults are 6s/5s for mocks and 25s/20s for Daytona.
# MATCH_PATCH_CADENCE_MS=25000
# MATCH_PROPOSAL_DEADLINE_MS=20000
# CLIENT_ORIGIN=https://your-frontend.example
# VITE_API_BASE_URL=https://your-match-server.example
