# Create a key at https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=your_daytona_api_key

# Optional Daytona defaults
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=eu

# Prepared once with: pnpm --filter @fork-fighter/gm-orchestrator prepare:snapshot
DAYTONA_WORKER_SNAPSHOT=fork-fighter-game-master-codex-v1

# Name of a Daytona organization secret mounted as CODEX_API_KEY.
# Never put the provider key value in this file or a VITE_* variable.
DAYTONA_CODEX_SECRET_NAME=fork-fighter-codex-api-key
