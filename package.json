{
  "name": "daytona-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm run build:root && pnpm --recursive --if-present run build",
    "build:root": "tsc -p tsconfig.json",
    "typecheck": "pnpm run typecheck:root && pnpm --recursive --if-present run typecheck",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --recursive --if-present run test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@fork-fighter/gm-orchestrator": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
